PORT=3000

# Required in production (Vercel production / NODE_ENV=production)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Required in production — min 16 chars. Used to lock POST /users/bootstrap after first super_admin.
BOOTSTRAP_SECRET=generate-a-long-random-string-and-keep-it-private

# Required in production: comma-separated browser origins, or "none" for Flutter-only (no web UI).
# Never use * .
CORS_ORIGINS=none

# Debug / demo switches — must be false or unset in production
SEED_ON_BOOT=false
ALLOW_MOCK_AUTH=false
ENABLE_SWAGGER=false
