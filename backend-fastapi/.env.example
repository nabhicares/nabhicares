APP_ENV=development
DATABASE_URL=postgresql+psycopg://user:password@host:5432/nabhi_care?sslmode=require
# Admin-only URL used by Alembic. Never expose it to the API runtime.
DATABASE_MIGRATION_URL=postgresql+psycopg://admin:password@host:5432/nabhi_care?sslmode=require
CORS_ORIGINS=http://localhost:3001

# Firebase Admin service-account values (not google-services.json values).
FIREBASE_PROJECT_ID=nabhi-cares
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
BOOTSTRAP_SECRET=replace-with-at-least-32-random-characters
