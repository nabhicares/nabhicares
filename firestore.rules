rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic Authentication check
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Check custom claims role
    function hasRole(role) {
      return request.auth.token.role == role;
    }

    // Check administrative permissions
    function isAdmin() {
      return hasRole('super_admin') || hasRole('hospital_admin');
    }

    // 1. Users Profiles
    match /users/{userId} {
      allow read, write: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    // 2. Patients Demographics & Medical Profile
    match /patients/{patientId} {
      allow read: if isAuthenticated() && (
        isOwner(patientId) ||
        hasRole('doctor') ||
        hasRole('receptionist') ||
        hasRole('pharmacist') ||
        isAdmin()
      );
      allow write: if isAuthenticated() && (isOwner(patientId) || hasRole('receptionist') || isAdmin());
    }

    // 3. Doctors Catalog & Consultation Configuration
    match /doctors/{doctorId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isOwner(doctorId) || isAdmin());
    }

    // 4. Appointments Slots
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        hasRole('receptionist') ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        hasRole('receptionist') ||
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        hasRole('receptionist') ||
        isAdmin()
      );
    }

    // 5. Electronic Medical Records (EMR)
    match /consultations/{consultationId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        hasRole('doctor') ||
        isAdmin()
      );
      allow write: if isAuthenticated() && (hasRole('doctor') || isAdmin());
    }

    // 6. Medical Prescriptions
    match /prescriptions/{prescriptionId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        hasRole('doctor') ||
        hasRole('pharmacist') ||
        isAdmin()
      );
      allow write: if isAuthenticated() && (hasRole('doctor') || hasRole('pharmacist') || isAdmin());
    }

    // 7. Inventory Catalog Medicines & Batch Sub-collections
    match /medicines/{medicineId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (hasRole('pharmacist') || isAdmin());

      match /batches/{batchNo} {
        allow read: if isAuthenticated() && (
          hasRole('pharmacist') ||
          hasRole('doctor') ||
          isAdmin()
        );
        allow write: if isAuthenticated() && (hasRole('pharmacist') || isAdmin());
      }
    }

    // 8. Audited Stock Overrides & Transactions
    match /stockTransactions/{txId} {
      allow read: if isAuthenticated() && (hasRole('pharmacist') || isAdmin());
      allow write: if isAuthenticated() && (hasRole('pharmacist') || isAdmin());
    }

    // 9. Suppliers Profile & Purchase Order Goods Receipts
    match /suppliers/{supplierId} {
      allow read, write: if isAuthenticated() && (hasRole('pharmacist') || isAdmin());
    }
    match /purchaseOrders/{orderId} {
      allow read, write: if isAuthenticated() && (hasRole('pharmacist') || isAdmin());
    }

    // 10. Billing Invoices, Payments Ledger, and Refunds
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        hasRole('receptionist') ||
        isAdmin()
      );
      allow write: if isAuthenticated() && (hasRole('receptionist') || isAdmin());
    }
    match /payments/{paymentId} {
      allow read, write: if isAuthenticated() && (hasRole('receptionist') || isAdmin());
    }
    match /refunds/{refundId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }

    // 11. Alerts & Push Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && isAdmin();
    }

    // 12. General Hospital Settings
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }
  }
}
